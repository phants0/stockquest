{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stockquest",
  "main": "./worker.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["TWELVEDATA_API_KEY"]
  }
}
